-- Suurim müügitulu: jalanõud – 774 034,75 €.
-- Väikseim müügitulu: laste_riided – 305 844,45 €.
-- Kõige rohkem müügikirjeid: meeste_riided – 2266.


-- ============================================
-- ÜLESANNE 5 – Inventuuriandmete kontroll
-- ============================================

SELECT COUNT(*) AS inventuuri_kirjeid
FROM inventory;

-- TULEMUS – ÜLESANNE 5
-- inventory tabelis on 1400 kirjet.
-- Inventuuriandmed on olemas ja laoseisu saab analüüsida.


-- ============================================
-- ÜLESANNE 6 – Juurdetellimist vajavad laoseisud
-- ============================================

SELECT
    p.product_name,
    i.location,
    i.quantity_available,
    i.reorder_point
FROM inventory i
JOIN products p ON i.product_id = p.product_id
WHERE i.quantity_available <= i.reorder_point
ORDER BY i.quantity_available ASC;

-- TULEMUS – ÜLESANNE 6
-- Leidsin laokirjeid, mille kogus on juurdetellimise
-- piiril või sellest väiksem.
-- Esines ka negatiivseid laoseise (näiteks -46).
-- Negatiivsed laoseisud vajavad täiendavat kontrolli.


-- ============================================
-- ÜLESANNE 7 – Juurdetellimist vajavate kirjete arv
-- ============================================

SELECT COUNT(*) AS juurdetellimist_vajavaid_kirjeid
FROM inventory
WHERE quantity_available <= reorder_point;

