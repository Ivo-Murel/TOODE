-- Lihtne INNER JOIN: kliendid, kes on ostnud
SELECT
    c.first_name,
    c.last_name,
    c.email,
    c.city,
    s.sale_id,
    s.sale_date,
    s.total_price
FROM sales s
INNER JOIN customers c ON s.customer_id = c.customer_id
LIMIT 20;
-- Käsk ühendab sale ning customer tabelid, kuvab küsitud read.
-- Kui käivitada käsklus ilma limit piirianguta, on andmebaasis 9130 kliendirida, kes on sooritanud ostu.
-- 

-- Leia TOP 10 klienti kogumüügi järgi?
SELECT
    c.first_name || ' ' || c.last_name AS klient,
    c.city,
    COUNT(DISTINCT s.sale_id) AS ostude_arv,
    TO_CHAR(SUM(s.total_price), 'FM999 999 999 990.00') AS kogumüük
FROM sales s
INNER JOIN customers c ON s.customer_id = c.customer_id
GROUP BY c.customer_id, c.first_name, c.last_name, c.city
ORDER BY SUM(s.total_price) DESC
LIMIT 10;
