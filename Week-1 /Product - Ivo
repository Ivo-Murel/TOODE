SELECT * FROM products LIMIT 10;

SELECT distinct products FROM products  -- näitab toodete koguarvu ja nende nimetusi 362 toodet

SELECT COUNT(*) AS toodete_arv FROM products; --näitab toodete koguarvu ühe numbriga 362 toodet

SELECT DISTINCT category FROM products; -- näitab mitu erinevat tootekategooriat on kokku

-- 10 kalleimat toodet
SELECT product_name, category, retail_price
FROM products
ORDER BY retail_price DESC
LIMIT 10;

-- 10 odavamat toodet
SELECT product_name, category, retail_price
FROM products
ORDER BY retail_price ASC
LIMIT 10;

