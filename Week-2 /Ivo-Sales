--Leia NULL väärtused kriitilistes väljades:
SELECT
    COUNT(*) FILTER (WHERE customer_id IS NULL) AS null_customer_id,
    COUNT(*) FILTER (WHERE sale_date IS NULL) AS null_sale_date,
    COUNT(*) FILTER (WHERE total_price IS NULL) AS null_total_price
FROM sales_test;
-- Kirjuta üles: ___1478___ NULL customer_id, ___0___ NULL sale_date, __0____ NULL total_price. Kokku 1487 rida millel puudub kliendi ID, kuid kõikidel kõikidel nendel müükidel on küljes kuupäev millal müük tehti ja müügi kogumaksumust

--Kontrolli kuupäevade formaati — kas on tuleviku kuupäevi?
SELECT COUNT(*) AS tuleviku_kuupaevad
FROM sales_test
WHERE sale_date > CURRENT_DATE
   OR sale_date < DATE '2020-01-01';   -- UrbanStyle.ltd asutati 2020
-- tulemus: See kontroll peaks tagastama 0 – ja 0 ONGI vastus, mitte ebaõnnestumine.

--Algaja analüütik peab siin aru saama vahest: *ridu ei tule, sest andmed on puhtad* versus ridu ei tule, sest mu päring on vale. Tõesta, et tegu on esimesega
Select count(*) as tuleviku_kuupäevad
From sales_test
WHERE sale_date > Date '2023-06-01' --otsib andmebaasist kõiki ridu, kus müügikuupäev on hilisem kui 1. juuni 2023 (ehk valed/tuleviku kuupäevad). Selles andmestikus andis see tingimus tulemuseks 12 849 rida.
   OR sale_date < DATE '2020-01-01';   -- UrbanStyle.ltd asutati 2020. Teine tingimus (OR tähendab "või"): otsib ridu, kus müügikuupäev on varasem kui 1. jaanuar 2020. Selles andmestikus oli see pool täiesti puhas ja andis tulemuseks 0 rida.
-- Tulemus tabelis on 12 849 rida, mille kuupäevad on loogikavastased (kas tulevikus või enne firma sünniperioodi). Kui enne sama päring loogiliste piiridega näitas tulemuseks 0, siis tavalises õiges vahemikus oli andmestik puhas, aga niipea kui piirid absurdseks muutsid, tuli massiliselt "prahti" nähtavale. Selles konkreetses andmestikus minevikupool on täiesti puhas (enne 2020. aastat valesid kuupäevi pole)

